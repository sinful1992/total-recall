#!/usr/bin/env bash
# Blocks pushing a v* tag if Cargo.toml or tauri.conf.json don't match it.
# One-time setup: git config core.hooksPath .githooks

while read local_ref local_sha remote_ref remote_sha; do
    if [[ "$local_ref" == refs/tags/v* ]]; then
        TAG="${local_ref#refs/tags/v}"
        CARGO=$(grep '^version' Cargo.toml | head -1 | sed 's/version = "\(.*\)"/\1/')
        TAURI=$(python3 -c "import json; print(json.load(open('tauri.conf.json'))['version'])")

        if [[ "$CARGO" != "$TAG" || "$TAURI" != "$TAG" ]]; then
            echo ""
            echo "  ✗  Version mismatch — cannot push tag v$TAG"
            echo "     Cargo.toml:      $CARGO"
            echo "     tauri.conf.json: $TAURI"
            echo "     Tag:             $TAG"
            echo ""
            echo "     Bump both files to $TAG and commit before tagging."
            echo ""
            exit 1
        fi
    fi
done
